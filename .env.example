# Environment Variables Template
# Sao chép file này thành .env.local để cấu hình trên máy cá nhân
# Tuyệt đối KHÔNG commit file .env.local lên GitHub

# Ví dụ biến môi trường cho Frontend (bắt đầu bằng NEXT_PUBLIC_):
# NEXT_PUBLIC_API_URL=http://localhost:3000/api
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Biến môi trường chỉ chạy ở Server / Backend (không có NEXT_PUBLIC_):
# DATABASE_URL=
# API_SECRET_KEY=
