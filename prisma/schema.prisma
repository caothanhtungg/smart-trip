generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TripStatus {
  ACTIVE
  SETTLING
  COMPLETED
  ARCHIVED
}

enum MemberRole {
  HOST
  MEMBER
}

enum MemberStatus {
  ACTIVE
  LEFT
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  LODGING
  TICKET
  SHOPPING
  OTHER
}

enum SplitMethod {
  EQUAL
  ITEMIZED
}

enum SettlementStatus {
  ACTIVE
  CANCELLED
}

enum TransferStatus {
  UNPAID
  PAID
  COMPLETED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
}

model User {
  id                    String              @id @default(uuid()) @db.Uuid
  email                 String              @unique @db.VarChar(255)
  name                  String              @db.VarChar(100)
  displayName           String?             @map("display_name") @db.VarChar(100)
  emailVerified         Boolean             @default(false) @map("email_verified")
  image                 String?             @map("image")
  bankBin               String?             @map("bank_bin") @db.VarChar(10)
  bankAccountNo         String?             @map("bank_account_no") @db.VarChar(255)
  bankAccountName       String?             @map("bank_account_name") @db.VarChar(100)
  bankAccountKeyVersion Int                 @default(1) @map("bank_account_key_version")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions              Session[]
  accounts              Account[]
  tripMembers           TripMember[]
  claims                MemberClaim[]
  snapshots             BankClaimSnapshot[]

  @@map("users")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("verifications")
}

model Trip {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @db.VarChar(150)
  destination    String?         @db.VarChar(150)
  startDate      DateTime        @map("start_date") @db.Date
  endDate        DateTime        @map("end_date") @db.Date
  budgetAmount   Int?            @map("budget_amount")
  status         TripStatus      @default(ACTIVE)
  inviteCode     String          @unique @map("invite_code") @db.VarChar(13)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  members        TripMember[]
  claims         MemberClaim[]
  itineraryItems ItineraryItem[]
  expenses       Expense[]
  settlements    Settlement[]

  @@map("trips")
}

model TripMember {
  id                    String               @id @default(uuid()) @db.Uuid
  tripId                String               @map("trip_id") @db.Uuid
  userId                String?              @map("user_id") @db.Uuid
  displayName           String               @map("display_name") @db.VarChar(100)
  role                  MemberRole           @default(MEMBER)
  status                MemberStatus         @default(ACTIVE)
  joinOrder             Int                  @map("join_order")
  joinedAt              DateTime             @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt                DateTime?            @map("left_at") @db.Timestamptz(6)
  bankBin               String?              @map("bank_bin") @db.VarChar(10)
  bankAccountNo         String?              @map("bank_account_no") @db.VarChar(255)
  bankAccountName       String?              @map("bank_account_name") @db.VarChar(100)
  bankAccountKeyVersion Int                  @default(1) @map("bank_account_key_version")
  trip                  Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user                  User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  placeholderClaims     MemberClaim[]        @relation("ClaimPlaceholder")
  decidedClaims         MemberClaim[]        @relation("ClaimDecider")
  itineraryCreated      ItineraryItem[]
  paidExpenses          Expense[]            @relation("ExpensePayer")
  createdExpenses       Expense[]            @relation("ExpenseCreator")
  shares                ExpenseShare[]
  itemMembers           ExpenseItemMember[]
  createdSettlements    Settlement[]
  transfersFrom         SettlementTransfer[] @relation("TransferFrom")
  transfersTo           SettlementTransfer[] @relation("TransferTo")
  paidTransfers         SettlementTransfer[] @relation("TransferPaidMarker")
  completedTransfers    SettlementTransfer[] @relation("TransferCompleter")
  snapshots             BankClaimSnapshot[]

  @@unique([tripId, userId])
  @@unique([tripId, displayName])
  @@unique([tripId, joinOrder])
  @@map("trip_members")
}

model MemberClaim {
  id                  String             @id @default(uuid()) @db.Uuid
  tripId              String             @map("trip_id") @db.Uuid
  placeholderMemberId String             @map("placeholder_member_id") @db.Uuid
  userId              String             @db.Uuid
  status              ClaimStatus        @default(PENDING)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt           DateTime?          @map("decided_at") @db.Timestamptz(6)
  decidedByMemberId   String?            @map("decided_by_member_id") @db.Uuid
  trip                Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  placeholderMember   TripMember         @relation("ClaimPlaceholder", fields: [placeholderMemberId], references: [id], onDelete: Restrict)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedBy           TripMember?        @relation("ClaimDecider", fields: [decidedByMemberId], references: [id], onDelete: Restrict)
  snapshot            BankClaimSnapshot?

  @@index([placeholderMemberId])
  @@index([tripId, userId])
  @@map("member_claims")
}

model BankClaimSnapshot {
  id                      String      @id @default(uuid()) @db.Uuid
  claimId                 String      @unique @map("claim_id") @db.Uuid
  placeholderMemberId     String      @map("placeholder_member_id") @db.Uuid
  userId                  String      @db.Uuid
  bankBin                 String?     @map("bank_bin") @db.VarChar(10)
  bankAccountNoCiphertext String      @map("bank_account_no_ciphertext") @db.VarChar(255)
  bankAccountName         String?     @map("bank_account_name") @db.VarChar(100)
  keyVersion              Int         @default(1) @map("key_version")
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  claim                   MemberClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  placeholderMember       TripMember  @relation(fields: [placeholderMemberId], references: [id], onDelete: Restrict)
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([placeholderMemberId])
  @@index([userId])
  @@map("bank_claim_snapshots")
}

model ItineraryItem {
  id                String     @id @default(uuid()) @db.Uuid
  tripId            String     @map("trip_id") @db.Uuid
  dayDate           DateTime   @map("day_date") @db.Date
  sortOrder         Int        @default(0) @map("sort_order")
  placeName         String     @map("place_name") @db.VarChar(200)
  address           String?
  note              String?
  startTime         DateTime?  @map("start_time") @db.Time(0)
  endTime           DateTime?  @map("end_time") @db.Time(0)
  createdByMemberId String     @map("created_by_member_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  trip              Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdByMember   TripMember @relation(fields: [createdByMemberId], references: [id], onDelete: Restrict)
  expenses          Expense[]

  @@index([tripId, dayDate, sortOrder])
  @@map("itinerary_items")
}

model Expense {
  id                String          @id @default(uuid()) @db.Uuid
  tripId            String          @map("trip_id") @db.Uuid
  itineraryItemId   String?         @map("itinerary_item_id") @db.Uuid
  title             String          @db.VarChar(200)
  amount            Int
  surchargeAmount   Int             @default(0) @map("surcharge_amount")
  category          ExpenseCategory @default(OTHER)
  paidByMemberId    String          @map("paid_by_member_id") @db.Uuid
  createdByMemberId String          @map("created_by_member_id") @db.Uuid
  splitMethod       SplitMethod     @default(EQUAL) @map("split_method")
  spentAt           DateTime        @default(now()) @map("spent_at") @db.Timestamptz(6)
  receiptImageUrl   String?         @map("receipt_image_url")
  note              String?
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  trip              Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  itineraryItem     ItineraryItem?  @relation(fields: [itineraryItemId], references: [id], onDelete: SetNull)
  paidBy            TripMember      @relation("ExpensePayer", fields: [paidByMemberId], references: [id], onDelete: Restrict)
  createdBy         TripMember      @relation("ExpenseCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  shares            ExpenseShare[]
  items             ExpenseItem[]

  @@index([tripId, spentAt])
  @@map("expenses")
}

model ExpenseShare {
  id        String     @id @default(uuid()) @db.Uuid
  expenseId String     @map("expense_id") @db.Uuid
  memberId  String     @map("member_id") @db.Uuid
  amount    Int
  expense   Expense    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member    TripMember @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([expenseId, memberId])
  @@map("expense_shares")
}

model ExpenseItem {
  id        String              @id @default(uuid()) @db.Uuid
  expenseId String              @map("expense_id") @db.Uuid
  name      String              @db.VarChar(200)
  amount    Int
  expense   Expense             @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  members   ExpenseItemMember[]

  @@index([expenseId])
  @@map("expense_items")
}

model ExpenseItemMember {
  itemId   String      @map("item_id") @db.Uuid
  memberId String      @map("member_id") @db.Uuid
  item     ExpenseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  member   TripMember  @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@id([itemId, memberId])
  @@map("expense_item_members")
}

model Settlement {
  id                String               @id @default(uuid()) @db.Uuid
  tripId            String               @map("trip_id") @db.Uuid
  status            SettlementStatus     @default(ACTIVE)
  createdByMemberId String               @map("created_by_member_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  cancelledAt       DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  trip              Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdByMember   TripMember           @relation(fields: [createdByMemberId], references: [id], onDelete: Restrict)
  transfers         SettlementTransfer[]

  @@index([tripId])
  @@map("settlements")
}

model SettlementTransfer {
  id                   String         @id @default(uuid()) @db.Uuid
  settlementId         String         @map("settlement_id") @db.Uuid
  fromMemberId         String         @map("from_member_id") @db.Uuid
  toMemberId           String         @map("to_member_id") @db.Uuid
  amount               Int
  status               TransferStatus @default(UNPAID)
  paymentMethod        PaymentMethod? @map("payment_method")
  paidAt               DateTime?      @map("paid_at") @db.Timestamptz(6)
  paidMarkedByMemberId String?        @map("paid_marked_by_member_id") @db.Uuid
  completedAt          DateTime?      @map("completed_at") @db.Timestamptz(6)
  completedByMemberId  String?        @map("completed_by_member_id") @db.Uuid
  settlement           Settlement     @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  fromMember           TripMember     @relation("TransferFrom", fields: [fromMemberId], references: [id], onDelete: Restrict)
  toMember             TripMember     @relation("TransferTo", fields: [toMemberId], references: [id], onDelete: Restrict)
  paidMarkedBy         TripMember?    @relation("TransferPaidMarker", fields: [paidMarkedByMemberId], references: [id], onDelete: Restrict)
  completedBy          TripMember?    @relation("TransferCompleter", fields: [completedByMemberId], references: [id], onDelete: Restrict)

  @@index([settlementId])
  @@index([fromMemberId])
  @@index([toMemberId])
  @@map("settlement_transfers")
}

model RateLimit {
  key     String   @id @db.VarChar(255)
  count   Int      @default(1)
  resetAt DateTime @map("reset_at") @db.Timestamptz(6)

  @@index([resetAt])
  @@map("rate_limits")
}
