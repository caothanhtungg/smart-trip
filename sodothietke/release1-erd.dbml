// ============================================================
// Smart Trip & Expense Planner - ERD Release 1 (PostgreSQL)
// Dán toàn bộ file này vào https://dbdiagram.io (Import / Editor)
// Quy ước: tiền = integer (đồng VND) | id = uuid | thời gian = timestamptz
// ============================================================

Project smart_trip {
  database_type: 'PostgreSQL'
  Note: '''
    Release 1: tài khoản, chuyến đi, lịch trình, chi tiêu, công nợ.
    Bảng của Auth.js (accounts, sessions, verification_tokens) do adapter tự tạo, không vẽ ở đây.
    NGUYÊN TẮC: mọi khoản tiền (người trả, phần chia, khoản nợ) trỏ tới trip_members, KHÔNG trỏ tới users,
    vì thành viên không tài khoản (R11) có user_id = NULL.
  '''
}

// ---------------- ENUM ----------------
Enum trip_status {
  ACTIVE [note: 'đang lên kế hoạch / đang đi']
  SETTLING [note: 'đã chốt sổ, đang thanh toán']
  COMPLETED [note: 'mọi khoản nợ đã hoàn tất']
  ARCHIVED [note: 'lưu trữ (R15)']
}
Enum member_role {
  HOST
  MEMBER
}
Enum member_status {
  ACTIVE
  LEFT [note: 'đã rời nhóm (R6), giữ lại lịch sử']
}
Enum expense_category {
  FOOD
  TRANSPORT
  LODGING
  TICKET
  SHOPPING
  OTHER
}
Enum split_method {
  EQUAL [note: 'chia đều (UC12)']
  ITEMIZED [note: 'chia theo món (UC31)']
}
Enum settlement_status {
  ACTIVE
  CANCELLED [note: 'Host mở lại sổ (R7)']
}
Enum transfer_status {
  UNPAID [note: 'chưa thanh toán']
  PAID [note: 'người nợ đã đánh dấu đã thanh toán']
  COMPLETED [note: 'người nhận đã xác nhận']
}
Enum claim_status {
  PENDING [note: 'chờ Host duyệt']
  APPROVED
  REJECTED
}
Enum payment_method {
  BANK_TRANSFER
  CASH
}

// ---------------- NHÓM 1: TÀI KHOẢN & CHUYẾN ĐI ----------------
Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [not null, unique]
  name varchar(100) [not null]
  image_url text
  bank_bin varchar(10) [note: 'mã BIN ngân hàng dùng cho VietQR']
  bank_account_no varchar(30) [note: 'mã hóa khi lưu (R9)']
  bank_account_name varchar(100)
  created_at timestamptz [not null, default: `now()`]
  Note: 'Người dùng thật, đăng nhập bằng Google (UC01). STK của thành viên có tài khoản nằm ở đây.'
}

Table trips {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(150) [not null]
  destination varchar(150)
  start_date date [not null]
  end_date date [not null]
  budget_amount integer [note: 'ngân sách dự kiến, có thể để trống']
  status trip_status [not null, default: 'ACTIVE']
  invite_code varchar(13) [not null, unique, note: '10-12 ký tự chữ/số + tối đa 1 dấu gạch nối (tối đa 13 ký tự), đổi mã = ghi đè cột này (UC28, R14)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'CHECK (end_date >= start_date). Chuyến đã có khoản chi chỉ được ARCHIVED, không xóa (R15).'
}

Table trip_members {
  id uuid [pk, default: `gen_random_uuid()`]
  trip_id uuid [not null]
  user_id uuid [note: 'NULL = thành viên không tài khoản (R11)']
  display_name varchar(100) [not null]
  role member_role [not null, default: 'MEMBER']
  status member_status [not null, default: 'ACTIVE']
  join_order integer [not null, note: 'thứ tự tham gia, dùng chia phần dư (R4)']
  joined_at timestamptz [not null, default: `now()`]
  left_at timestamptz
  bank_bin varchar(10) [note: 'chỉ dùng khi user_id IS NULL, Host nhập hộ (R9, R12)']
  bank_account_no varchar(30)
  bank_account_name varchar(100)

  indexes {
    (trip_id, user_id) [unique, name: 'uq_member_user_in_trip']
    (trip_id, display_name) [unique, name: 'uq_member_name_in_trip']
    (trip_id, join_order) [unique, name: 'uq_member_join_order']
  }
  Note: '''
    - Postgres cho phép nhiều NULL trong unique nên nhiều thành viên không tài khoản vẫn hợp lệ.
    - Mỗi chuyến đúng 1 HOST (R2): thêm partial unique index bằng SQL thô:
      CREATE UNIQUE INDEX one_host_per_trip ON trip_members(trip_id) WHERE role = 'HOST';
    - STK dùng để tạo QR = users.bank_* nếu user_id có giá trị, ngược lại = trip_members.bank_*.
    - Liên kết thành viên ảo với tài khoản (UC33 yêu cầu, UC30 Host duyệt, R13): đi qua bảng member_claims; khi được duyệt thì gán user_id và xóa bank_* ở đây.
    - Không DELETE thành viên có dữ liệu liên quan, chỉ đổi status = LEFT (R6).
  '''
}

Table member_claims {
  id uuid [pk, default: `gen_random_uuid()`]
  trip_id uuid [not null]
  placeholder_member_id uuid [not null, note: 'thành viên ảo mà người dùng nhận là mình']
  user_id uuid [not null, note: 'người gửi yêu cầu, CHƯA có dòng trip_members nên chưa xem được dữ liệu chuyến (R1)']
  status claim_status [not null, default: 'PENDING']
  created_at timestamptz [not null, default: `now()`]
  decided_at timestamptz
  decided_by_member_id uuid [note: 'Host duyệt hoặc từ chối']

  indexes {
    placeholder_member_id
    (trip_id, user_id)
  }
  Note: '''
    Yêu cầu "tôi là [tên thành viên ảo]" (UC33), chờ Host duyệt (UC30).
    Mỗi tài khoản tối đa 1 yêu cầu PENDING mỗi chuyến (R20), thêm bằng SQL thô:
    CREATE UNIQUE INDEX one_pending_claim ON member_claims(trip_id, user_id) WHERE status = 'PENDING';
    Duyệt = gán trip_members.user_id (giữ nguyên join_order và lịch sử), các yêu cầu PENDING khác của cùng thành viên ảo tự chuyển REJECTED.
  '''
}

// ---------------- NHÓM 2: LỊCH TRÌNH ----------------
Table itinerary_items {
  id uuid [pk, default: `gen_random_uuid()`]
  trip_id uuid [not null]
  day_date date [not null, note: 'ngày trong lịch trình']
  sort_order integer [not null, default: 0]
  place_name varchar(200) [not null]
  address text
  lat decimal(9,6) [note: 'tọa độ, dùng cho bản đồ (tuần 6) và tối ưu lộ trình (Release 2)']
  lng decimal(9,6)
  start_time time
  end_time time
  note text
  created_by_member_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (trip_id, day_date, sort_order)
  }
  Note: 'Địa điểm trong lịch trình là điểm chung nối bản đồ, thời tiết và chi tiêu. Release 2 có thể tách bảng places.'
}

// ---------------- NHÓM 3: CHI TIÊU ----------------
Table expenses {
  id uuid [pk, default: `gen_random_uuid()`]
  trip_id uuid [not null]
  itinerary_item_id uuid [note: 'gắn với địa điểm, có thể để trống']
  title varchar(200) [not null]
  amount integer [not null, note: 'đồng VND, CHECK > 0 (R3)']
  category expense_category [not null, default: 'OTHER']
  paid_by_member_id uuid [not null, note: 'người ứng tiền']
  created_by_member_id uuid [not null, note: 'người nhập; Host nhập hộ thì = Host (R5, R12)']
  split_method split_method [not null, default: 'EQUAL']
  spent_at timestamptz [not null, default: `now()`]
  receipt_image_url text [note: 'ảnh hóa đơn (UC32), chưa OCR']
  note text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (trip_id, spent_at)
    paid_by_member_id
  }
  Note: 'Sau khi chốt sổ (trips.status <> ACTIVE) ứng dụng chặn mọi sửa/xóa (R7).'
}

Table expense_shares {
  id uuid [pk, default: `gen_random_uuid()`]
  expense_id uuid [not null]
  member_id uuid [not null]
  amount integer [not null, note: 'phần của người này, CHECK >= 0']

  indexes {
    (expense_id, member_id) [unique]
    member_id
  }
  Note: 'KẾT QUẢ chia tiền (cả chia đều lẫn theo món). Quy tắc R4: SUM(amount) của một expense = expenses.amount. Phải có test tự động.'
}

Table expense_items {
  id uuid [pk, default: `gen_random_uuid()`]
  expense_id uuid [not null]
  name varchar(200) [not null]
  amount integer [not null, note: 'thành tiền của món']

  Note: 'Chỉ dùng khi split_method = ITEMIZED. Phí dịch vụ/VAT: nhập thành một món riêng hoặc phân bổ theo tỷ lệ (chốt khi viết thuật toán).'
}

Table expense_item_members {
  item_id uuid [not null]
  member_id uuid [not null]

  indexes {
    (item_id, member_id) [pk]
  }
  Note: 'Ai ăn/uống món nào. Một món gán cho nhiều người thì chia đều giữa họ.'
}

// ---------------- NHÓM 4: CÔNG NỢ ----------------
Table settlements {
  id uuid [pk, default: `gen_random_uuid()`]
  trip_id uuid [not null]
  status settlement_status [not null, default: 'ACTIVE']
  created_by_member_id uuid [not null, note: 'Host chốt sổ']
  created_at timestamptz [not null, default: `now()`]
  cancelled_at timestamptz

  Note: '''
    Một lần chốt sổ (UC15). Mỗi chuyến tối đa 1 bản ACTIVE:
    CREATE UNIQUE INDEX one_active_settlement ON settlements(trip_id) WHERE status = 'ACTIVE';
    Mở lại sổ (UC22) = đổi sang CANCELLED, rồi chốt lại sẽ tạo bản mới.
  '''
}

Table settlement_transfers {
  id uuid [pk, default: `gen_random_uuid()`]
  settlement_id uuid [not null]
  from_member_id uuid [not null, note: 'người nợ']
  to_member_id uuid [not null, note: 'người nhận']
  amount integer [not null, note: 'CHECK > 0']
  status transfer_status [not null, default: 'UNPAID']
  payment_method payment_method [note: 'chuyển khoản hoặc tiền mặt (R8, R17)']
  paid_at timestamptz
  paid_marked_by_member_id uuid [note: 'người đánh dấu; Host thì là trả hộ (R12)']
  completed_at timestamptz
  completed_by_member_id uuid [note: 'người xác nhận đã nhận']

  indexes {
    settlement_id
    from_member_id
    to_member_id
  }
  Note: 'Kết quả rút gọn nợ (UC16). CHECK (from_member_id <> to_member_id). Mã QR sinh tại chỗ từ STK người nhận, KHÔNG lưu.'
}

// ---------------- QUAN HỆ ----------------
Ref: trip_members.trip_id > trips.id [delete: cascade]
Ref: trip_members.user_id > users.id [delete: set null]

Ref: member_claims.trip_id > trips.id [delete: cascade]
Ref: member_claims.placeholder_member_id > trip_members.id [delete: restrict]
Ref: member_claims.user_id > users.id [delete: cascade]
Ref: member_claims.decided_by_member_id > trip_members.id [delete: restrict]

Ref: itinerary_items.trip_id > trips.id [delete: cascade]
Ref: itinerary_items.created_by_member_id > trip_members.id [delete: restrict]

Ref: expenses.trip_id > trips.id [delete: cascade]
Ref: expenses.itinerary_item_id > itinerary_items.id [delete: set null]
Ref: expenses.paid_by_member_id > trip_members.id [delete: restrict]
Ref: expenses.created_by_member_id > trip_members.id [delete: restrict]

Ref: expense_shares.expense_id > expenses.id [delete: cascade]
Ref: expense_shares.member_id > trip_members.id [delete: restrict]

Ref: expense_items.expense_id > expenses.id [delete: cascade]
Ref: expense_item_members.item_id > expense_items.id [delete: cascade]
Ref: expense_item_members.member_id > trip_members.id [delete: restrict]

Ref: settlements.trip_id > trips.id [delete: cascade]
Ref: settlements.created_by_member_id > trip_members.id [delete: restrict]

Ref: settlement_transfers.settlement_id > settlements.id [delete: cascade]
Ref: settlement_transfers.from_member_id > trip_members.id [delete: restrict]
Ref: settlement_transfers.to_member_id > trip_members.id [delete: restrict]
Ref: settlement_transfers.paid_marked_by_member_id > trip_members.id [delete: restrict]
Ref: settlement_transfers.completed_by_member_id > trip_members.id [delete: restrict]

// ---------------- NHÓM MÀU TRÊN SƠ ĐỒ ----------------
TableGroup nhom_chuyen_di [color: #3498DB] {
  users
  trips
  trip_members
  member_claims
}
TableGroup nhom_lich_trinh [color: #27AE60] {
  itinerary_items
}
TableGroup nhom_chi_tieu [color: #E67E22] {
  expenses
  expense_shares
  expense_items
  expense_item_members
}
TableGroup nhom_cong_no [color: #8E44AD] {
  settlements
  settlement_transfers
}
