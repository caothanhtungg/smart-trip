etry></mxCell><mxCell id="c58" value="" style="endArrow=block;endFill=0;endSize=16;html=1;strokeColor=#333333;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1510" y="991"/><mxPoint x="100" y="991"/></Array></mxGeometry></mxCell><mxCell id="c59" value="&lt;b&gt;Chú thích:&lt;/b&gt; xanh dương = use case của Member · cam = use case chỉ Host · xám = use case được include/extend (không ai bấm trực tiếp) · nét đứt «include» = luôn kéo theo · «extend» = mở rộng tùy chọn · mũi tên rỗng = kế thừa (Host kế thừa Member)&lt;br&gt;&lt;br&gt;&lt;b&gt;Tiền điều kiện chung:&lt;/b&gt; đã đăng nhập (trừ UC01). &lt;b&gt;Vai trò xét theo từng chuyến đi:&lt;/b&gt; khi thực hiện UC03, hệ thống tạo chuyến mới và gán quyền Host của chuyến đó cho người tạo. UC21 có tiền điều kiện: người thực hiện không phải Host của chuyến (R2) và không còn số dư khác 0 (R6). &lt;b&gt;UC05&lt;/b&gt; gồm bước xem thẻ xem trước chuyến (R19). &lt;b&gt;UC33&lt;/b&gt;: người mới chọn mình là một thành viên ảo, &lt;b&gt;UC30&lt;/b&gt;: Host duyệt thì mới liên kết (R13, R20). &lt;b&gt;UC34&lt;/b&gt;: QR sinh ngay trên trình duyệt từ link mời. UC26 xem R11, R12; UC24 xem R15." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff9e6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="1050" width="1140" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="3. Lịch trình và Chi tiêu"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c60" value="Nhóm LỊCH TRÌNH và CHI TIÊU" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="240" y="30" width="1140" height="732" as="geometry"/></mxCell><mxCell id="c61" value="Member" style="shape=umlActor;verticalLabelPosition=top;verticalAlign=bottom;labelPosition=center;align=center;html=1;outlineConnect=0;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="371" width="40" height="80" as="geometry"/></mxCell><mxCell id="c62" value="Host" style="shape=umlActor;verticalLabelPosition=top;verticalAlign=bottom;labelPosition=center;align=center;html=1;outlineConnect=0;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1490" y="371" width="40" height="80" as="geometry"/></mxCell><mxCell id="c63" value="Host kế thừa Member nên làm được mọi use case trong hình, và có thêm quyền sửa/xóa khoản chi của người khác (R5) và nhập thay thành viên không tài khoản (R12)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff9e6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1420" y="470" width="280" height="120" as="geometry"/></mxCell><mxCell id="c64" value="UC08&lt;br&gt;Thêm địa điểm" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="100" width="260" height="70" as="geometry"/></mxCell><mxCell id="c65" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;html=1;endArrow=none;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c61" target="c64"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c66" value="UC09&lt;br&gt;Sửa/xóa địa điểm" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="192" width="260" height="70" as="geometry"/></mxCell><mxCell id="c67" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;html=1;endArrow=none;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c61" target="c66"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c68" value="UC10&lt;br&gt;Xem lịch trình theo ngày" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="284" width="260" height="70" as="geometry"/></mxCell><mxCell id="c69" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;html=1;endArrow=none;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c61" target="c68"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c70" value="UC11&lt;br&gt;Thêm khoản chi" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="376" width="260" height="70" as="geometry"/></mxCell><mxCell id="c71" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;html=1;endArrow=none;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c61" target="c70"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c72" value="UC13&lt;br&gt;Sửa/xóa khoản chi" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="468" width="260" height="70" as="geometry"/></mxCell><mxCell id="c73" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;html=1;endArrow=none;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c61" target="c72"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c74" value="UC14&lt;br&gt;Xem danh sách chi tiêu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="560" width="260" height="70" as="geometry"/></mxCell><mxCell id="c75" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;html=1;endArrow=none;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c61" target="c74"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c76" value="UC25&lt;br&gt;Xem số dư cá nhân" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="652" width="260" height="70" as="geometry"/></mxCell><mxCell id="c77" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;html=1;endArrow=none;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c61" target="c76"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c78" value="UC12&lt;br&gt;Chia tiền khoản chi" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="376" width="260" height="70" as="geometry"/></mxCell><mxCell id="c79" value="UC32&lt;br&gt;Đính kèm ảnh hóa đơn" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="284" width="260" height="70" as="geometry"/></mxCell><mxCell id="c80" value="UC31&lt;br&gt;Chia theo món" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1070" y="376" width="260" height="70" as="geometry"/></mxCell><mxCell id="c81" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c70" target="c78"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c82" value="«extend»" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c79" target="c70"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c83" value="«extend»" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c80" target="c78"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c84" value="" style="endArrow=block;endFill=0;endSize=16;html=1;strokeColor=#333333;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c62" target="c61"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1510" y="807"/><mxPoint x="100" y="807"/></Array></mxGeometry></mxCell><mxCell id="c85" value="&lt;b&gt;Chú thích:&lt;/b&gt; xanh dương = use case của Member · cam = use case chỉ Host · xám = use case được include/extend (không ai bấm trực tiếp) · nét đứt «include» = luôn kéo theo · «extend» = mở rộng tùy chọn · mũi tên rỗng = kế thừa (Host kế thừa Member)&lt;br&gt;&lt;br&gt;&lt;b&gt;Ghi chú:&lt;/b&gt; UC12 mặc định chia đều; UC31 (chia theo món) là phần mở rộng tùy chọn. UC32 chỉ lưu ảnh, chưa đọc OCR (để Release 3). Host cũng nhập UC11/UC13 thay thành viên không tài khoản (R12). UC13 theo R5: người tạo khoản chi hoặc Host." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff9e6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="860" width="1140" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page4" name="4. Công nợ"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c86" value="Nhóm CÔNG NỢ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="240" y="30" width="1140" height="640" as="geometry"/></mxCell><mxCell id="c87" value="Member" style="shape=umlActor;verticalLabelPosition=top;verticalAlign=bottom;labelPosition=center;align=center;html=1;outlineConnect=0;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="233" width="40" height="80" as="geometry"/></mxCell><mxCell id="c88" value="Host" style="shape=umlActor;verticalLabelPosition=top;verticalAlign=bottom;labelPosition=center;align=center;html=1;outlineConnect=0;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1490" y="509" width="40" height="80" as="geometry"/></mxCell><mxCell id="c89" value="UC17&lt;br&gt;Xem bảng công nợ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="100" width="260" height="70" as="geometry"/></mxCell><mxCell id="c90" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;html=1;endArrow=none;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c87" target="c89"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c91" value="UC19&lt;br&gt;Thanh toán khoản nợ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="192" width="260" height="70" as="geometry"/></mxCell><mxCell id="c92" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;html=1;endArrow=none;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c87" target="c91"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c93" value="UC20&lt;br&gt;Xác nhận đã nhận tiền" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="284" width="260" height="70" as="geometry"/></mxCell><mxCell id="c94" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;html=1;endArrow=none;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c87" target="c93"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c95" value="UC29&lt;br&gt;Nhắc nợ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="376" width="260" height="70" as="geometry"/></mxCell><mxCell id="c96" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;html=1;endArrow=none;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c87" target="c95"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c97" value="UC18&lt;br&gt;Tạo mã QR thanh toán" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="192" width="260" height="70" as="geometry"/></mxCell><mxCell id="c98" value="«extend»" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c97" target="c91"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c99" value="UC15&lt;br&gt;Chốt sổ công nợ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1070" y="468" width="260" height="70" as="geometry"/></mxCell><mxCell id="c100" value="UC22&lt;br&gt;Mở lại sổ công nợ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1070" y="560" width="260" height="70" as="geometry"/></mxCell><mxCell id="c101" value="UC16&lt;br&gt;Rút gọn nợ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="468" width="260" height="70" as="geometry"/></mxCell><mxCell id="c102" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c99" target="c101"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c103" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;html=1;endArrow=none;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c88" target="c99"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c104" value="" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;html=1;endArrow=none;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c88" target="c100"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c105" value="" style="endArrow=block;endFill=0;endSize=16;html=1;strokeColor=#333333;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c88" target="c87"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1510" y="715"/><mxPoint x="100" y="715"/></Array></mxGeometry></mxCell><mxCell id="c106" value="&lt;b&gt;Chú thích:&lt;/b&gt; xanh dương = use case của Member · cam = use case chỉ Host · xám = use case được include/extend (không ai bấm trực tiếp) · nét đứt «include» = luôn kéo theo · «extend» = mở rộng tùy chọn · mũi tên rỗng = kế thừa (Host kế thừa Member)&lt;br&gt;&lt;br&gt;&lt;b&gt;Ghi chú:&lt;/b&gt; UC20 do người nhận thực hiện; với thành viên không tài khoản, Host đánh dấu thay (R12). UC19: người nợ trả bằng chuyển khoản hoặc tiền mặt rồi đánh dấu đã thanh toán. UC18 là mở rộng tùy chọn: chỉ sinh QR khi trả bằng chuyển khoản và người nhận đã có STK (R17). UC22 chỉ làm được khi chưa ai đánh dấu đã thanh toán (R7). UC29 bản đầu chỉ sao chép nội dung nhắc để dán vào Zalo (R16)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff9e6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="775" width="1140" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>